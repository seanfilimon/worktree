{
  "name": "@worktree/web",
  "version": "0.8.0",
  "private": true,
  "scripts": {
    "prepare": "fumadocs-mdx || true",
    "dev": "fumadocs-mdx && next dev",
    "build": "fumadocs-mdx && next build",
    "start": "next start",
    "lint": "eslint . && node scripts/check-links.mjs",
    "check-links": "node scripts/check-links.mjs",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "clean": "node -e \"for (const d of ['.next', '.source', 'node_modules']) require('fs').rmSync(d, { recursive: true, force: true })\""
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/mdx": "^2.0.13",
    "fumadocs-core": "^16.7.7",
    "fumadocs-mdx": "^15",
    "fumadocs-ui": "^16.7.7",
    "lenis": "^1.3.26",
    "motion": "^12.38.0",
    "next": "^16.2.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.1.0",
    "eslint-config-next": "^16.2.1",
    "github-slugger": "^2.0.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  }
}
