{
  "name": "@worktree/web",
  "version": "0.8.0",
  "private": true,
  "scripts": {
    "prepare": "fumadocs-mdx || true",
    "dev": "fumadocs-mdx && next dev",
    "build": "fumadocs-mdx && next build",
    "start": "next start",
    "lint": "eslint . && node scripts/check-links.mjs",
    "check-links": "node scripts/check-links.mjs",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "clean": "node -e \"for (const d of ['.next', '.source', 'node_modules']) require('fs').rmSync(d, { recursive: true, force: true })\""
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.17.8",
    "fumadocs-mdx": "^14",
    "fumadocs-ui": "^16.17.8",
    "geist": "^1.8.2",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "github-slugger": "^2.0.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2"
  }
}
