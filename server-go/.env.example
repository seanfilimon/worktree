# Go server configuration
WT_SERVER_HTTP_ADDR=127.0.0.1:8080
WT_SERVER_GRPC_ADDR=127.0.0.1:9877
WT_SERVER_DATABASE_URL=postgres://worktree:worktree@localhost:5432/worktree?sslmode=disable
WT_SERVER_RUN_MIGRATIONS=false
WT_SERVER_LOG_LEVEL=info
WT_SERVER_STORAGE_ROOT=.wt-server-go
WT_SERVER_AUDIT_PATH=.wt-server-go/audit/audit.jsonl
WT_SERVER_AUTH_TOKEN=

# Rust client configuration
WT_SERVER_URL=http://127.0.0.1:8080
WT_TENANT=default

# Test database (for Postgres integration tests)
WT_TEST_DATABASE_URL=postgres://worktree:worktree@localhost:5432/worktree?sslmode=disable
