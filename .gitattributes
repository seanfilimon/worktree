# Normalize all text to LF in the repository and in working trees.
* text=auto eol=lf

# Windows-native scripts keep CRLF in the working tree.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Shell scripts must stay LF even on Windows checkouts.
*.sh   text eol=lf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.avif  binary
*.bmp   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.mp3   binary
*.mp4   binary
*.mov   binary
*.webm  binary
*.wasm  binary
*.zip   binary
*.gz    binary
*.tgz   binary
*.tar   binary
*.7z    binary
*.exe   binary
*.dll   binary
*.so    binary
*.dylib binary
*.db    binary

# Generated code (collapsed in diffs, excluded from language stats)
services/server-go/internal/proto/syncpb/*.pb.go linguist-generated=true
package-lock.json linguist-generated=true
Cargo.lock        linguist-generated=true
