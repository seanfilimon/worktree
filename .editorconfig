root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.go]
indent_style = tab
indent_size = 4

[{Makefile,*.mk,go.mod,go.sum}]
indent_style = tab

[*.{ps1,psm1,psd1,cmd,bat}]
end_of_line = crlf
indent_size = 4

[*.proto]
indent_size = 2

[*.{md,mdx}]
trim_trailing_whitespace = false
