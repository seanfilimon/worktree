# /etc/worktree/server.env -- environment for worktree-server.service.
# Mode 0640, group worktree: it holds secrets. Empty values are ignored.
# Every variable has a matching flag; see `worktree-server --help` and
# docs/deploy.md.

# Bootstrap the server admin account (remove after the first start if you
# prefer; the account stays).
WT_ADMIN_USER=admin
WT_ADMIN_PASSWORD=

# Externally visible URL (behind a reverse proxy: the proxy's URL).
WT_PUBLIC_URL=
# Reverse proxies whose X-Forwarded-For is trusted, e.g. 127.0.0.1,::1
WT_TRUSTED_PROXIES=
WT_ALLOW_REGISTRATION=false
WT_LOG_LEVEL=info

# Serve TLS directly (otherwise terminate TLS at the reverse proxy and keep
# WT_ADDR on loopback, e.g. 127.0.0.1:7420).
#WT_ADDR=:7420
#WT_TLS_CERT=/etc/worktree/tls/fullchain.pem
#WT_TLS_KEY=/etc/worktree/tls/privkey.pem

# Object store in S3 instead of /var/lib/worktree/objects (v0.7+).
#WT_OBJECT_STORE=s3
#WT_S3_ENDPOINT=s3.amazonaws.com
#WT_S3_BUCKET=
#WT_S3_REGION=
#WT_S3_ACCESS_KEY=
#WT_S3_SECRET_KEY=

# Notification e-mail (v0.7+).
#WT_SMTP_URL=smtp://user:pass@smtp.example.com:587
#WT_SMTP_FROM=W0rkTree <worktree@example.com>

# Scheduled backups into /var/lib/worktree/backups (v0.7+).
#WT_BACKUP_INTERVAL=24h
#WT_BACKUP_KEEP=7
