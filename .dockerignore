# Build context for Dockerfile.server and apps/web/Dockerfile (both use the
# repository root as context). Patterns are anchored at the context root, so
# nested artifacts need a **/ prefix.

# VCS / CI / tooling
.git
.github/
.claude/
.turbo/
**/.turbo
.vscode/
.idea/

# Rust (not needed by any image)
target/
**/target
crates/
Cargo.lock
**/*.rs.bk

# Dependencies (installed fresh in the image)
**/node_modules
.pnpm-store/

# Build outputs (rebuilt in the image)
**/.next
**/.source
**/dist
**/out
**/build
**/*.tsbuildinfo
**/next-env.d.ts
services/server-go/worktree-server
services/server-go/worktree-server.exe

# Runtime data
**/wt-data
**/*.db

# Testing & coverage
**/coverage
**/.nyc_output
tests/

# Logs
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/*.log

# Environment / secrets
**/.env
**/.env*.local
**/*.pem

# Editors & OS files
**/*.swp
**/*.swo
**/*~
**/.DS_Store
**/Thumbs.db

# Docs & misc not needed by images
docs/
video/
scripts/
**/*.md
!apps/web/content/**/*.md
!apps/web/content/**/*.mdx
.vercel/
